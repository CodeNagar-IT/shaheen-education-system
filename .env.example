# Database
# Local development uses SQLite (zero-config). For production on Render/Supabase,
# switch prisma/schema.prisma datasource provider to "postgresql" and set:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shaheen?schema=public"
DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional: Clerk (if you migrate from NextAuth)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# File storage — Uploadthing
# UPLOADTHING_TOKEN=
# UPLOADTHING_SECRET=

# File storage — Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Public school contact
NEXT_PUBLIC_SCHOOL_PHONE="+92-300-5512345"
NEXT_PUBLIC_SCHOOL_WHATSAPP="923005512345"
NEXT_PUBLIC_SCHOOL_EMAIL="info@shaheen.edu.pk"
